{
  "name": "dsh-plugin-sticky-wall",
  "version": "1.3.3",
  "type": "module",
  "description": "便签墙：DSH 侧栏一块可自由摆放的便签墙（待办勾选、有序/无序列表、横线纸开关、可调大小、纸感纹理、拖拽摆放、跨会话持久化），并给模型 4 个 sticky_wall_* 工具，让「记到便签墙」这类话直接落到墙上。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmengle/dsh-plugin-sticky-wall.git"
  },
  "homepage": "https://github.com/zmengle/dsh-plugin-sticky-wall#readme",
  "bugs": {
    "url": "https://github.com/zmengle/dsh-plugin-sticky-wall/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes",
    "note-wall",
    "便签墙"
  ],
  "license": "MIT"
}
